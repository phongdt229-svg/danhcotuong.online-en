# .env.docker.example — biến môi trường cho `docker compose --env-file .env.docker`
# Copy thành .env.docker rồi điền giá trị thật. KHÔNG commit .env.docker.

# ===== MySQL =====
DB_NAME=chinesechess
DB_USER=chinesechess
DB_PASSWORD=doi-mat-khau-manh-o-day
DB_ROOT_PASSWORD=doi-mat-khau-root-o-day

# ===== Phiên đăng nhập =====
# Sinh mới cho production, KHÔNG dùng lại chuỗi của môi trường khác:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Có HTTPS thì để true. Chưa có HTTPS mà để true sẽ KHÔNG đăng nhập được.
COOKIE_SECURE=true

# ===== Nạp điểm qua PayPal =====
# live = tiền thật. Key live lấy ở developer.paypal.com > Apps & Credentials > Live.
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
POINTS_PER_USD=10

# ===== Cược điểm khi đấu với người =====
STAKE_MIN=150
STAKE_WINNER_PERCENT=80
# id tài khoản nhận 20% hoa hồng. Bỏ trống thì phần đó chỉ được ghi sổ, không vào tài khoản nào.
ADMIN_USER_ID=
