# ===== Cấu hình máy chủ =====
# development | production
NODE_ENV=development
PORT=3000

# ===== Cấu hình MySQL (mặc định của XAMPP) =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=danhcotuong-en

# ===== Phiên đăng nhập =====
# Sinh chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=doi-chuoi-bi-mat-nay-thanh-ngau-nhien

# Bật cookie secure (chỉ gửi cookie qua HTTPS). 'true' khi chạy sau Nginx + HTTPS.
# Khi NODE_ENV=production mặc định đã bật; đặt 'false' nếu cần test production qua HTTP thuần.
COOKIE_SECURE=false

# ===== Nạp điểm qua PayPal =====
# Lấy key tại developer.paypal.com > Apps & Credentials.
# sandbox = tiền giả để test | live = tiền thật
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Tỉ giá quy đổi: 1 USD = bao nhiêu điểm
POINTS_PER_USD=10

# ===== Cược điểm khi đấu với người =====
# Mức cược tối thiểu mỗi bên.
STAKE_MIN=150
# Người thắng nhận bao nhiêu % tổng cược (phần còn lại về admin).
STAKE_WINNER_PERCENT=80
# (tuỳ chọn) id tài khoản nhận phần của admin. Bỏ trống thì chỉ ghi sổ, không cộng vào ai.
# ADMIN_USER_ID=

# ===== Kết nối DB cloud qua TLS (Render/Railway + Aiven/TiDB...) =====
# Để TRỐNG khi chạy local (XAMPP). Khi dùng MySQL cloud, đặt DB_SSL=true.
# DB_SSL=true
# (tuỳ chọn) dán nội dung cert CA của nhà cung cấp để xác thực chặt:
# DB_SSL_CA=
# (tuỳ chọn) ép bật/tắt xác thực cert: true | false
# DB_SSL_REJECT_UNAUTHORIZED=

# ===== Google reCAPTCHA v3 (chống bot ở form đăng ký / đăng nhập) =====
# Khoá lấy tại google.com/recaptcha/admin, phải đúng loại "reCAPTCHA v3".
# Nhớ khai báo tên miền trong mục Domains (thêm cả 'localhost' để test ở máy).
# Để trống 2 khoá = tắt reCAPTCHA, form vẫn chạy bình thường.
RECAPTCHA_ENABLED=1
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Điểm tối thiểu để được qua (0.0-1.0). 0.5 là mức Google khuyến nghị.
RECAPTCHA_MIN_SCORE=0.5
# Google không gọi được thì '1' = vẫn cho đăng nhập, '0' = chặn.
RECAPTCHA_FAIL_OPEN=1
